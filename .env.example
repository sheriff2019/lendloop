# ---------------------------------------------------------------------------
# docker-compose (n8n + Mailpit). Copy to .env, or run: npm run setup:secrets
# .env is git-ignored. Never commit real values.
# ---------------------------------------------------------------------------

# Encrypts n8n's stored credentials. Generate once; changing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=

# HMAC secrets, one per direction (64 hex chars each). The SAME values must be set
# in Convex:  npx convex env set CONVEX_TO_N8N_SECRET ... / N8N_TO_CONVEX_SECRET ...
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# Where n8n (inside Docker) reaches Convex HTTP actions. Local backend: port 3211.
# For a cloud deployment use https://<your-deployment>.convex.site
CONVEX_SITE_URL_FOR_N8N=http://host.docker.internal:3211

APP_URL=http://localhost:3000
MAIL_FROM=LendLoop <no-reply@lendloop.local>
ADMIN_ALERT_EMAIL=admin@lendloop.local
TIMEZONE=UTC

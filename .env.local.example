# ---------------------------------------------------------------------------
# Next.js (copy to .env.local). `npx convex dev` fills in the two CONVEX lines.
# Only PUBLIC values and the Clerk secret key live here; HMAC secrets live in
# Convex's environment and in .env (n8n), never in the browser bundle.
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

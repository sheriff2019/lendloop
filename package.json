    "check": "npm run typecheck && npm run lint && npm test && npm run check:workflows",
    "setup:secrets": "node scripts/setup-secrets.mjs",
    "seed": "convex run seed:demo"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "convex": "^1.49.0",
    "next": "15.5.29",
    "react": "~19.1.4",
    "react-dom": "~19.1.4"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.55",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.67",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
